@inject TelemetryApiClient Api

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_loading)
{
    <p class="text-muted"><em>Loading session…</em></p>
}
else if (_session is null)
{
    <div class="ft-card"><p class="mb-0 text-muted">Session not found.</p></div>
}
else
{
    <p class="text-muted mb-3 session-meta">
        @_session.SessionName
        · @(_session.DateStart?.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) ?? "—") UTC
    </p>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(_tab == "results" ? "active" : null)" @onclick='() => _tab = "results"'>Results</button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(_tab == "laps" ? "active" : null)" @onclick="ShowLapsAsync">Laps</button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(_tab == "pace" ? "active" : null)" @onclick="ShowPaceAsync">Pace</button>
        </li>
    </ul>

    @if (_tab == "results")
    {
        @if (_results is { Count: > 0 })
        {
            var segmented = ResultDisplay.IsSegmentedResults(_results);
            var segments = segmented ? ResultDisplay.MaxSegmentCount(_results) : 0;
            var cutoffs = segmented ? ResultDisplay.QualifyingCutoffs(_results, segments) : null;
            var prefix = ResultDisplay.SegmentPrefix(_session.SessionName);
            var focusSeg = segmented ? _qualiView : null; // null = Classification
            var pole = _results.FirstOrDefault(x => x.Position == 1);
            var rows = focusSeg is int fs
                ? BuildSegmentViewRows(fs, segments).ToList()
                : SortedResults(segmented, segments, pole)
                    .Select(r => new ResultsRow(r, r.Position, null, null))
                    .ToList();
            var showElimDividers = cutoffs is not null && _resultsSort.Column == "pos";
            var colCount = 5 + (segmented ? segments : 1);

            @if (segmented && segments >= 2)
            {
                <div class="pace-metric quali-view-switch mb-2" role="group" aria-label="Qualifying results view">
                    <button type="button"
                            class="pace-metric-btn @(_qualiView is null ? "is-on" : null)"
                            @onclick="() => SetQualiView(null)">
                        Classification (Overall)
                    </button>
                    @foreach (var s in Enumerable.Range(0, segments))
                    {
                        <button type="button"
                                class="pace-metric-btn @(_qualiView == s ? "is-on" : null)"
                                @onclick="() => SetQualiView(s)">
                            @ResultDisplay.SegmentHeader(s, segments, _session.SessionName) Results
                        </button>
                    }
                </div>
            }

            <div class="ft-card results-wrap">
                <table class="results-table @(segmented ? "is-quali" : null) @(focusSeg is int ? "has-quali-focus" : null)">
                    <thead>
                        <tr>
                            <th class="@_resultsSort.HeaderClass("pos")" data-col="pos" @onclick='() => SortResults("pos")'>Pos</th>
                            <th class="@_resultsSort.HeaderClass("no")" data-col="no" @onclick='() => SortResults("no")'>No</th>
                            <th class="@_resultsSort.HeaderClass("driver")" data-col="driver" @onclick='() => SortResults("driver")'>Driver</th>
                            @if (segmented)
                            {
                                @foreach (var s in Enumerable.Range(0, segments))
                                {
                                    var col = $"q{s}";
                                    var focusCls = focusSeg == s ? "is-seg-focus" : focusSeg is int ? "is-seg-dim" : null;
                                    <th class="@_resultsSort.HeaderClass(col) @focusCls" data-col="@col" @onclick="() => SortResults(col)">
                                        @ResultDisplay.SegmentHeader(s, segments, _session.SessionName)
                                    </th>
                                }
                            }
                            else
                            {
                                <th class="@_resultsSort.HeaderClass("time")" data-col="time" @onclick='() => SortResults("time")'>Time</th>
                            }
                            <th class="@_resultsSort.HeaderClass("gap")" data-col="gap" @onclick='() => SortResults("gap")'>Gap</th>
                            <th class="@_resultsSort.HeaderClass("laps")" data-col="laps" @onclick='() => SortResults("laps")'>Laps</th>
                            <th class="@_resultsSort.HeaderClass("status")" data-col="status" @onclick='() => SortResults("status")'>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            var r = row.Result;
                            var displayPos = row.DisplayPos;
                            var isLeader = focusSeg is int
                                ? displayPos == 1
                                : r.Position == 1 && !r.Dnf && !r.Dns && !r.Dsq;
                            var gapText = focusSeg is int
                                ? (isLeader ? "Leader" : ResultDisplay.FormatGapDelta(row.GapSeconds))
                                : (isLeader ? "Leader" : FormatResultsGap(r, segmented, pole));
                            var status = segmented
                                ? ResultDisplay.QualifyingStatus(r, segments, _session.SessionName, cutoffs)
                                : null;
                            <tr class="@(focusSeg is null ? ResultDisplay.PodiumClass(r.Position) : ResultDisplay.PodiumClass(displayPos))">
                                <td class="col-pos">
                                    <span class="pos-badge">@(displayPos?.ToString() ?? "—")</span>
                                </td>
                                <td class="col-no mono">@r.DriverNumber</td>
                                <td>
                                    <div class="driver-cell">
                                        <span class="team-stripe" style="background: @TeamColors.ForTeam(r.TeamName)" title="@(r.TeamName ?? "Team")"></span>
                                        <div class="driver-meta">
                                            <span class="name">@(r.DriverName ?? r.NameAcronym ?? "—")</span>
                                            <span class="team">@(r.TeamName ?? "—")</span>
                                        </div>
                                    </div>
                                </td>
                                @if (segmented)
                                {
                                    @foreach (var s in Enumerable.Range(0, segments))
                                    {
                                        var t = ResultDisplay.SegmentAt(r.DurationJson, s);
                                        var missed = t is null or <= 0;
                                        var best = SegmentBestClass(s, t);
                                        var focusCls = focusSeg == s ? "is-seg-focus" : focusSeg is int ? "is-seg-dim" : null;
                                        <td class="mono @focusCls @(missed ? "cell-dnq" : best)">@ResultDisplay.FormatLapSeconds(t)</td>
                                    }
                                }
                                else
                                {
                                    var t = ResultDisplay.FinalSegmentTime(r.DurationJson);
                                    <td class="mono @RaceBestClass(t)">@ResultDisplay.FormatLapSeconds(t)</td>
                                }
                                <td class="mono gap-cell @(isLeader ? "is-leader" : null)">@gapText</td>
                                <td class="mono">@(r.NumberOfLaps?.ToString() ?? "—")</td>
                                <td>
                                    @if (status is { } st)
                                    {
                                        <span class="@st.Css">@st.Label</span>
                                    }
                                    else if (r.Dnf) { <span class="ft-badge ft-badge-dnf">DNF</span> }
                                    else if (r.Dns) { <span class="ft-badge ft-badge-dns">DNS</span> }
                                    else if (r.Dsq) { <span class="ft-badge ft-badge-dsq">DSQ</span> }
                                    else { <span class="text-muted">—</span> }
                                </td>
                            </tr>
                            @if (showElimDividers && cutoffs is { } c && displayPos is int pos)
                            {
                                @if (focusSeg is null)
                                {
                                    if (pos == c.Q3Cutoff)
                                    {
                                        <tr class="quali-elim-row" aria-label="Eliminated in @($"{prefix}2")">
                                            <td colspan="@colCount">
                                                <div class="quali-elim-band is-q2">
                                                    <span class="quali-elim-line"></span>
                                                    <span class="quali-elim-label">OUT IN @($"{prefix}2")</span>
                                                    <span class="quali-elim-line"></span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else if (pos == c.Q2Cutoff)
                                    {
                                        <tr class="quali-elim-row" aria-label="Eliminated in @($"{prefix}1")">
                                            <td colspan="@colCount">
                                                <div class="quali-elim-band is-q1">
                                                    <span class="quali-elim-line"></span>
                                                    <span class="quali-elim-label">OUT IN @($"{prefix}1")</span>
                                                    <span class="quali-elim-line"></span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else if (focusSeg == 0 && pos == c.Q2Cutoff)
                                {
                                    <tr class="quali-elim-row" aria-label="Eliminated in @($"{prefix}1")">
                                        <td colspan="@colCount">
                                            <div class="quali-elim-band is-q1">
                                                <span class="quali-elim-line"></span>
                                                <span class="quali-elim-label">OUT IN @($"{prefix}1")</span>
                                                <span class="quali-elim-line"></span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else if (focusSeg == 1 && pos == c.Q3Cutoff)
                                {
                                    <tr class="quali-elim-row" aria-label="Eliminated in @($"{prefix}2")">
                                        <td colspan="@colCount">
                                            <div class="quali-elim-band is-q2">
                                                <span class="quali-elim-line"></span>
                                                <span class="quali-elim-label">OUT IN @($"{prefix}2")</span>
                                                <span class="quali-elim-line"></span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ft-card"><p class="mb-0 text-muted">No results for this session.</p></div>
        }
    }
    else if (_tab == "laps")
    {
        @if (_lapsLoading)
        {
            <p class="text-muted"><em>Loading laps…</em></p>
        }
        else if (_evaluatedLaps is { Count: > 0 })
        {
            var laps = SortedLaps().ToList();
            var phaseOpts = _lapsQualiPhases;
            var showPhaseUi = _showQualiFilter && phaseOpts.Count > 0;
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <p class="text-muted mb-0">
                    @if (showPhaseUi && _lapsQualiFilter is int qf)
                    {
                        <span>@laps.Count rows for @_qualiPrefix@qf</span>
                    }
                    else
                    {
                        <span>@laps.Count rows</span>
                    }
                    <span> · </span>
                    <span class="timing-purple">purple</span> = overall best ·
                    <span class="timing-green">green</span> = personal best ·
                    <span class="timing-yellow">yellow</span> = no improvement
                </p>
                @if (showPhaseUi)
                {
                    <div class="pace-metric" role="group" aria-label="Qualifying lap segment">
                        <button type="button"
                                class="pace-metric-btn @(_lapsQualiFilter is null ? "is-on" : null)"
                                @onclick="() => SetLapsQualiFilter(null)">
                            All Laps
                        </button>
                        @foreach (var phase in phaseOpts)
                        {
                            <button type="button"
                                    class="pace-metric-btn @(_lapsQualiFilter == phase ? "is-on" : null)"
                                    @onclick="() => SetLapsQualiFilter(phase)">
                                @_qualiPrefix@phase
                            </button>
                        }
                    </div>
                }
            </div>
            @if (_lapsDriverChips.Count > 0)
            {
                <DriverSelectionBar CssClass="mb-2"
                                    Drivers="_lapsDriverChips"
                                    Selected="_lapsSelectedDrivers"
                                    SelectedChanged="OnLapsDriversSelected"
                                    MinSelected="1" />
            }
            <div class="ft-card results-wrap" style="max-height: 36rem;">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th class="@_lapsSort.HeaderClass("lap")" @onclick='() => SortLaps("lap")'>Lap</th>
                            <th class="@_lapsSort.HeaderClass("driver")" @onclick='() => SortLaps("driver")'>Driver</th>
                            <th class="@_lapsSort.HeaderClass("time")" @onclick='() => SortLaps("time")'>Lap time</th>
                            <th class="@_lapsSort.HeaderClass("s1")" @onclick='() => SortLaps("s1")'>Sector 1</th>
                            <th class="@_lapsSort.HeaderClass("s2")" @onclick='() => SortLaps("s2")'>Sector 2</th>
                            <th class="@_lapsSort.HeaderClass("s3")" @onclick='() => SortLaps("s3")'>Sector 3</th>
                            <th class="@_lapsSort.HeaderClass("st")" @onclick='() => SortLaps("st")'>ST</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int? prevPhase = null;
                        }
                        @foreach (var lap in laps)
                        {
                            if (showPhaseUi
                                && _lapsQualiFilter is null
                                && _lapsSort.Column == "lap"
                                && lap.QualifyingPhase is int curPhase
                                && prevPhase is int prev
                                && curPhase != prev)
                            {
                                <tr class="quali-elim-row laps-phase-row">
                                    <td colspan="7">
                                        <div class="quali-elim-band @(curPhase >= 3 ? "is-q2" : "is-q1")">
                                            <span class="quali-elim-line"></span>
                                            <span class="quali-elim-label">
                                                END OF @_qualiPrefix@prev / START OF @_qualiPrefix@curPhase
                                            </span>
                                            <span class="quali-elim-line"></span>
                                        </div>
                                    </td>
                                </tr>
                            }

                            if (lap.QualifyingPhase is int pShown)
                            {
                                prevPhase = pShown;
                            }

                            <tr>
                                <td class="mono lap-cell">
                                    <span>@lap.LapNumber</span>
                                    @if (showPhaseUi && lap.QualifyingPhase is int qp)
                                    {
                                        <span class="ft-badge ft-badge-lap-q ft-badge-lap-q@qp" title="@($"{_qualiPrefix}{qp}")">@_qualiPrefix@qp</span>
                                    }
                                    @if (lap.IsPitOutLap == true)
                                    {
                                        <span class="ft-badge ft-badge-out" title="Pit out lap — incomplete timing">OUT</span>
                                    }
                                </td>
                                <td>
                                    <div class="driver-cell">
                                        <span class="team-stripe" style="background: @TeamColors.ForTeam(lap.TeamName)" title="@(lap.TeamName ?? "Team")"></span>
                                        <div class="driver-meta">
                                            <span class="name">@lap.DisplayName</span>
                                            <span class="team">#@lap.DriverNumber@(string.IsNullOrEmpty(lap.TeamName) ? "" : $" · {lap.TeamName}")</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="mono @TimingColorCss.Class(lap.LapTime.Color)">@ResultDisplay.FormatLapSeconds(lap.LapTime.Seconds)</td>
                                <td class="mono @TimingColorCss.Class(lap.Sector1.Color)">@ResultDisplay.FormatLapSeconds(lap.Sector1.Seconds)</td>
                                <td class="mono @TimingColorCss.Class(lap.Sector2.Color)">@ResultDisplay.FormatLapSeconds(lap.Sector2.Seconds)</td>
                                <td class="mono @TimingColorCss.Class(lap.Sector3.Color)">@ResultDisplay.FormatLapSeconds(lap.Sector3.Seconds)</td>
                                <td class="mono">@(lap.StSpeed?.ToString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ft-card"><p class="mb-0 text-muted">No laps for this session.</p></div>
        }
    }
    else if (_tab == "pace")
    {
        @if (_lapsLoading)
        {
            <p class="text-muted"><em>Loading pace data…</em></p>
        }
        else if (_pacePoints is { Count: > 0 })
        {
            <LapTimeChart Points="_pacePoints"
                          Stints="_paceStints"
                          TeamByDriver="_paceTeams"
                          CircuitShortName="@_session?.CircuitShortName"
                          Location="@_session?.Location"
                          ShowQualifyingFilter="@_showQualiFilter"
                          QualifyingSegmentPrefix="@_qualiPrefix"
                          SessionName="@_session?.SessionName"
                          SessionType="@_session?.SessionType"
                          SessionResults="_results"
                          StartingGridPositions="_startingGridPositions" />
        }
        else
        {
            <div class="ft-card"><p class="mb-0 text-muted">No lap times available for pace chart.</p></div>
        }
    }
}

@code {
    [Parameter] public int SessionKey { get; set; }

    private SessionDto? _session;
    private List<SessionResultDto>? _results;
    private List<EvaluatedLap>? _evaluatedLaps;
    private List<LapTimePointDto>? _pacePoints;
    private List<StintDto> _paceStints = [];
    private Dictionary<int, string>? _paceTeams;
    private bool _showQualiFilter;
    private string _qualiPrefix = "Q";
    private List<int> _lapsQualiPhases = [];
    /// <summary>null = All Laps; 1/2/3 = Q1/Q2/Q3 filter on Laps tab.</summary>
    private int? _lapsQualiFilter;
    private List<DriverChipOption> _lapsDriverChips = [];
    private readonly HashSet<int> _lapsSelectedDrivers = new();
    private Dictionary<int, int>? _startingGridPositions;
    /// <summary>null = Classification (Overall); 0/1/2 = Q1/Q2/Q3 segment view.</summary>
    private int? _qualiView;
    private bool _loading = true;
    private bool _lapsLoading;
    private string _tab = "results";
    private string? _error;
    private int _loadedKey = -1;

    private readonly List<double?> _segmentBests = [];
    private double? _raceBest;

    private readonly TableSortState _resultsSort = new("pos");
    private readonly TableSortState _lapsSort = new("lap");

    private sealed record ResultsRow(
        SessionResultDto Result,
        int? DisplayPos,
        double? SegmentTime,
        double? GapSeconds);

    protected override async Task OnParametersSetAsync()
    {
        if (SessionKey == _loadedKey && _session is not null) return;

        _loading = true;
        _error = null;
        _tab = "results";
        _evaluatedLaps = null;
        _pacePoints = null;
        _paceStints = [];
        _paceTeams = null;
        _showQualiFilter = false;
        _qualiPrefix = "Q";
        _lapsQualiPhases = [];
        _lapsQualiFilter = null;
        _lapsDriverChips = [];
        _lapsSelectedDrivers.Clear();
        _startingGridPositions = null;
        _qualiView = null;
        _segmentBests.Clear();
        _raceBest = null;
        _resultsSort.Reset("pos");
        _lapsSort.Reset("lap");
        try
        {
            _session = await Api.GetSessionAsync(SessionKey);
            _results = _session is null ? null : await Api.GetResultsAsync(SessionKey);
            var grid = _session is null ? null : await Api.GetStartingGridAsync(SessionKey);
            _startingGridPositions = grid is { Count: > 0 }
                ? grid.GroupBy(g => g.DriverNumber).ToDictionary(g => g.Key, g => g.First().Position)
                : null;
            ComputeResultBests();
            _loadedKey = SessionKey;
        }
        catch (Exception ex)
        {
            _error = $"API error: {ex.Message}";
            _loadedKey = -1;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SortResults(string column) => _resultsSort.Toggle(column);

    private void SortLaps(string column) => _lapsSort.Toggle(column);

    private void SetQualiView(int? segmentIndex)
    {
        if (_qualiView == segmentIndex) return;
        _qualiView = segmentIndex;
        // Default: ascending by segment time (Pos) / overall grid position.
        _resultsSort.Reset("pos", ascending: true);
    }

    private IEnumerable<ResultsRow> BuildSegmentViewRows(int segmentIndex, int segments)
    {
        if (_results is null || segmentIndex < 0 || segmentIndex >= segments) return [];

        var participants = _results
            .Select(r => (Result: r, Time: ResultDisplay.SegmentAt(r.DurationJson, segmentIndex)))
            .Where(x => x.Time is > 0)
            .ToList();

        if (participants.Count == 0) return [];

        var best = participants.Min(x => x.Time!.Value);

        // Rank by segment time first (stable classification for this segment).
        var ranked = participants
            .OrderBy(x => x.Time)
            .ThenBy(x => x.Result.Position ?? int.MaxValue)
            .Select((x, i) => new ResultsRow(
                x.Result,
                i + 1,
                x.Time,
                x.Time!.Value - best))
            .ToList();

        return _resultsSort.Column switch
        {
            "no" => _resultsSort.Apply(ranked, r => (IComparable?)r.Result.DriverNumber),
            "driver" => _resultsSort.Apply(ranked, r => (IComparable?)(r.Result.DriverName ?? r.Result.NameAcronym ?? "")),
            "gap" => _resultsSort.Apply(ranked, r => (IComparable?)r.GapSeconds),
            "laps" => _resultsSort.Apply(ranked, r => (IComparable?)r.Result.NumberOfLaps),
            "status" => _resultsSort.Apply(ranked, r => (IComparable?)StatusSortKey(r.Result, true, segments)),
            var col when col.StartsWith("q", StringComparison.Ordinal) &&
                         int.TryParse(col.AsSpan(1), out var qi) =>
                _resultsSort.Apply(ranked, r => (IComparable?)ResultDisplay.SegmentAt(r.Result.DurationJson, qi)),
            // Pos (default) keeps segment-time order; flipping asc/desc reverses it.
            _ => _resultsSort.Ascending
                ? ranked.OrderBy(r => r.DisplayPos)
                : ranked.OrderByDescending(r => r.DisplayPos)
        };
    }

    private IEnumerable<SessionResultDto> SortedResults(bool segmented, int segments, SessionResultDto? pole)
    {
        if (_results is null) return [];

        return _resultsSort.Column switch
        {
            "no" => _resultsSort.Apply(_results, r => (IComparable?)r.DriverNumber),
            "driver" => _resultsSort.Apply(_results, r => (IComparable?)(r.DriverName ?? r.NameAcronym ?? "")),
            "time" => _resultsSort.Apply(_results, r => (IComparable?)ResultDisplay.FinalSegmentTime(r.DurationJson)),
            "gap" => _resultsSort.Apply(_results, r => (IComparable?)GapSortKey(r, segmented, pole)),
            "laps" => _resultsSort.Apply(_results, r => (IComparable?)r.NumberOfLaps),
            "status" => _resultsSort.Apply(_results, r => (IComparable?)StatusSortKey(r, segmented, segments)),
            var col when col.StartsWith("q", StringComparison.Ordinal) &&
                         int.TryParse(col.AsSpan(1), out var qi) =>
                _resultsSort.Apply(_results, r => (IComparable?)ResultDisplay.SegmentAt(r.DurationJson, qi)),
            _ => _resultsSort.Apply(_results, r => (IComparable?)r.Position)
        };
    }

    private void SetLapsQualiFilter(int? phase)
    {
        if (_lapsQualiFilter == phase) return;
        _lapsQualiFilter = phase;
        _lapsSort.Reset("lap", ascending: true);
        RebuildLapsDriverChips();
    }

    private void OnLapsDriversSelected(IReadOnlySet<int> next)
    {
        _lapsSelectedDrivers.Clear();
        foreach (var n in next)
        {
            if (_lapsDriverChips.Any(d => d.Number == n))
            {
                _lapsSelectedDrivers.Add(n);
            }
        }

        if (_lapsSelectedDrivers.Count == 0 && _lapsDriverChips.Count > 0)
        {
            _lapsSelectedDrivers.Add(_lapsDriverChips[0].Number);
        }
    }

    private void RebuildLapsDriverChips()
    {
        if (_evaluatedLaps is null)
        {
            _lapsDriverChips = [];
            _lapsSelectedDrivers.Clear();
            return;
        }

        IEnumerable<EvaluatedLap> pool = _evaluatedLaps;
        int? focusSeg = null;
        if (_lapsQualiFilter is int phase)
        {
            pool = _evaluatedLaps.Where(l => l.QualifyingPhase == phase);
            focusSeg = phase - 1;
        }
        var grouped = pool.GroupBy(l => l.DriverNumber).ToList();
        var ordered = DriverOrder.OrderDriverNumbers(
            grouped.Select(g => g.Key),
            _results,
            _session?.SessionName,
            _session?.SessionType,
            focusSeg,
            _startingGridPositions);

        var byNumber = grouped.ToDictionary(g => g.Key, g => g.First());
        var teammateIndex = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        _lapsDriverChips = ordered
            .Where(byNumber.ContainsKey)
            .Select(number =>
            {
                var sample = byNumber[number];
                var code = sample.NameAcronym ?? $"#{sample.DriverNumber}";
                var team = sample.TeamName ?? "";
                teammateIndex.TryGetValue(team, out var idx);
                if (!string.IsNullOrWhiteSpace(team)) teammateIndex[team] = idx + 1;
                var color = TeamColors.ForTeam(sample.TeamName, idx);
                return new DriverChipOption(sample.DriverNumber, code, color);
            })
            .ToList();

        _lapsSelectedDrivers.RemoveWhere(n => _lapsDriverChips.All(d => d.Number != n));
        if (_lapsSelectedDrivers.Count == 0)
        {
            foreach (var d in _lapsDriverChips)
            {
                _lapsSelectedDrivers.Add(d.Number);
            }
        }
    }

    private IEnumerable<EvaluatedLap> FilteredLaps()
    {
        if (_evaluatedLaps is null) return [];

        IEnumerable<EvaluatedLap> source = _evaluatedLaps;
        if (_lapsQualiFilter is int phase)
        {
            source = source.Where(l => l.QualifyingPhase == phase);
        }

        if (_lapsSelectedDrivers.Count > 0 && _lapsDriverChips.Count > 0)
        {
            source = source.Where(l => _lapsSelectedDrivers.Contains(l.DriverNumber));
        }

        return source;
    }

    private IEnumerable<EvaluatedLap> SortedLaps()
    {
        var source = FilteredLaps();
        if (!source.Any()) return [];

        // In All Laps + QUALI, keep phases grouped so END/START banners can appear.
        if (_showQualiFilter && _lapsQualiFilter is null && _lapsSort.Column == "lap")
        {
            var ordered = source
                .OrderBy(l => l.QualifyingPhase ?? 99)
                .ThenBy(l => l.LapNumber)
                .ThenBy(l => l.DriverNumber);
            return _lapsSort.Ascending ? ordered : ordered.Reverse();
        }

        return _lapsSort.Column switch
        {
            "driver" => _lapsSort.Apply(source, l => (IComparable?)l.DisplayName),
            "time" => _lapsSort.Apply(source, l => (IComparable?)l.LapTime.Seconds),
            "s1" => _lapsSort.Apply(source, l => (IComparable?)l.Sector1.Seconds),
            "s2" => _lapsSort.Apply(source, l => (IComparable?)l.Sector2.Seconds),
            "s3" => _lapsSort.Apply(source, l => (IComparable?)l.Sector3.Seconds),
            "st" => _lapsSort.Apply(source, l => (IComparable?)l.StSpeed),
            _ => _lapsSort.Apply(source, l => (IComparable?)l.LapNumber)
        };
    }

    private static double? GapSortKey(SessionResultDto r, bool segmented, SessionResultDto? pole)
    {
        if (r.Position == 1 && !r.Dnf && !r.Dns && !r.Dsq) return 0;

        if (!segmented)
        {
            var parts = ResultDisplay.ParseSecondsParts(r.GapToLeaderJson);
            for (var i = parts.Count - 1; i >= 0; i--)
            {
                if (parts[i] is not null) return parts[i];
            }

            return null;
        }

        if (pole is null) return null;
        var poleParts = ResultDisplay.ParseSecondsParts(pole.DurationJson);
        var myParts = ResultDisplay.ParseSecondsParts(r.DurationJson);
        var decisive = -1;
        for (var i = poleParts.Count - 1; i >= 0; i--)
        {
            if (poleParts[i] is > 0)
            {
                decisive = i;
                break;
            }
        }

        if (decisive < 0 || decisive >= myParts.Count || myParts[decisive] is not > 0) return null;
        return myParts[decisive]!.Value - poleParts[decisive]!.Value;
    }

    private int StatusSortKey(SessionResultDto r, bool segmented, int segments)
    {
        if (r.Dsq) return 30;
        if (r.Dnf) return 20;
        if (r.Dns) return 10;

        if (segmented)
        {
            var cutoffs = ResultDisplay.QualifyingCutoffs(_results ?? [], segments);
            var st = ResultDisplay.QualifyingStatus(r, segments, _session?.SessionName, cutoffs);
            if (st is { } s)
            {
                if (s.Label.EndsWith("3", StringComparison.Ordinal)) return 0;
                if (s.Label.Contains("2 Eliminated", StringComparison.Ordinal)) return 1;
                if (s.Label.Contains("1 Eliminated", StringComparison.Ordinal)) return 2;
            }
        }

        return 0;
    }

    private void ComputeResultBests()
    {
        _segmentBests.Clear();
        _raceBest = null;
        if (_results is null || _results.Count == 0) return;

        if (ResultDisplay.IsSegmentedResults(_results))
        {
            var n = ResultDisplay.MaxSegmentCount(_results);
            for (var s = 0; s < n; s++)
            {
                double? best = null;
                foreach (var r in _results)
                {
                    var t = ResultDisplay.SegmentAt(r.DurationJson, s);
                    if (t is > 0 && (best is null || t < best)) best = t;
                }

                _segmentBests.Add(best);
            }
        }
        else
        {
            foreach (var r in _results)
            {
                var t = ResultDisplay.FinalSegmentTime(r.DurationJson);
                if (t is > 0 && (_raceBest is null || t < _raceBest)) _raceBest = t;
            }
        }
    }

    private string FormatResultsGap(SessionResultDto r, bool segmented, SessionResultDto? pole)
    {
        if (!segmented)
        {
            return ResultDisplay.FormatGap(r.GapToLeaderJson);
        }

        if (pole is null) return "—";

        var poleParts = ResultDisplay.ParseSecondsParts(pole.DurationJson);
        var myParts = ResultDisplay.ParseSecondsParts(r.DurationJson);
        var decisive = -1;
        for (var i = poleParts.Count - 1; i >= 0; i--)
        {
            if (poleParts[i] is > 0)
            {
                decisive = i;
                break;
            }
        }

        if (decisive < 0) return "—";
        if (decisive >= myParts.Count || myParts[decisive] is not > 0) return "—";

        return ResultDisplay.FormatGapDelta(myParts[decisive]!.Value - poleParts[decisive]!.Value);
    }

    private string SegmentBestClass(int segmentIndex, double? time)
    {
        if (time is null or <= 0) return "";
        if (segmentIndex < 0 || segmentIndex >= _segmentBests.Count) return "";
        var best = _segmentBests[segmentIndex];
        if (best is not null && Math.Abs(time.Value - best.Value) < 0.0005) return "cell-sb";
        return "";
    }

    private string RaceBestClass(double? time)
    {
        if (time is null or <= 0 || _raceBest is null) return "";
        return Math.Abs(time.Value - _raceBest.Value) < 0.0005 ? "cell-sb" : "";
    }

    private async Task ShowLapsAsync()
    {
        _tab = "laps";
        await EnsureLapsLoadedAsync();
    }

    private async Task ShowPaceAsync()
    {
        _tab = "pace";
        await EnsureLapsLoadedAsync();
    }

    private async Task EnsureLapsLoadedAsync()
    {
        if (_evaluatedLaps is not null || _session is null) return;

        _lapsLoading = true;
        try
        {
            var raw = await Api.GetLapsAsync(SessionKey) ?? [];
            _paceStints = await Api.GetStintsAsync(SessionKey) ?? [];
            var lapPositions = await Api.GetLapPositionsAsync(SessionKey) ?? [];
            _evaluatedLaps = LapTimingEvaluator.Evaluate(raw).ToList();
            _pacePoints = MapPacePoints(raw, _paceStints, lapPositions);
            _paceTeams = raw
                .Where(l => !string.IsNullOrWhiteSpace(l.TeamName))
                .GroupBy(l => l.DriverNumber)
                .ToDictionary(g => g.Key, g => g.First().TeamName!);

            _qualiPrefix = UiFormat.QualifyingSegmentPrefix(_session.SessionName);
            _showQualiFilter = false;
            _lapsQualiPhases = [];
            _lapsQualiFilter = null;
            if (UiFormat.IsQualifyingSession(_session.SessionName, _session.SessionType))
            {
                var phases = await Api.GetQualifyingPhasesAsync(SessionKey) ?? [];
                if (phases.Count > 0)
                {
                    QualifyingLapAssigner.ApplyPhases(_pacePoints, raw, phases);
                    QualifyingLapAssigner.ApplyPhases(_evaluatedLaps, phases);
                    _lapsQualiPhases = phases
                        .Select(p => p.Phase)
                        .Where(p => p is >= 1 and <= 3)
                        .Distinct()
                        .OrderBy(p => p)
                        .ToList();
                    // Keep only phases that actually have laps.
                    _lapsQualiPhases = _lapsQualiPhases
                        .Where(p => _evaluatedLaps.Any(l => l.QualifyingPhase == p))
                        .ToList();
                    _showQualiFilter = _lapsQualiPhases.Count > 0;
                }
            }

            RebuildLapsDriverChips();
        }
        catch (Exception ex)
        {
            _error = $"API error loading laps: {ex.Message}";
        }
        finally
        {
            _lapsLoading = false;
        }
    }

    private static List<LapTimePointDto> MapPacePoints(
        IEnumerable<LapDto> laps,
        IReadOnlyList<StintDto> stints,
        IReadOnlyList<LapPositionDto> lapPositions)
    {
        var byDriver = stints
            .GroupBy(s => s.DriverNumber)
            .ToDictionary(g => g.Key, g => g.OrderBy(s => s.StintNumber).ToList());

        var posByKey = lapPositions
            .GroupBy(p => (p.DriverNumber, p.LapNumber))
            .ToDictionary(g => g.Key, g => g.First().Position);

        return laps
            .Select(l =>
            {
                StintDto? stint = null;
                if (byDriver.TryGetValue(l.DriverNumber, out var list))
                {
                    stint = list.FirstOrDefault(s =>
                        l.LapNumber >= (s.LapStart ?? int.MinValue)
                        && l.LapNumber <= (s.LapEnd ?? int.MaxValue));
                }

                int? tyreAge = null;
                if (stint?.LapStart is int start)
                {
                    tyreAge = (stint.TyreAgeAtStart ?? 0) + (l.LapNumber - start);
                }

                posByKey.TryGetValue((l.DriverNumber, l.LapNumber), out var position);

                return new LapTimePointDto
                {
                    LapNumber = l.LapNumber,
                    LapTimeSeconds = l.LapDuration is > 0 ? l.LapDuration.Value : 0,
                    Sector1Seconds = l.DurationSector1 is > 0 ? l.DurationSector1.Value : 0,
                    Sector2Seconds = l.DurationSector2 is > 0 ? l.DurationSector2.Value : 0,
                    Sector3Seconds = l.DurationSector3 is > 0 ? l.DurationSector3.Value : 0,
                    TopSpeedKmh = l.StSpeed is > 0 ? l.StSpeed.Value : 0,
                    DriverCode = l.NameAcronym,
                    DriverName = l.DriverName,
                    DriverNumber = l.DriverNumber,
                    Compound = stint?.Compound,
                    TyreAge = tyreAge,
                    StintNumber = stint?.StintNumber,
                    IsPitLap = l.IsPitOutLap == true,
                    Position = position > 0 ? position : null,
                    DateStart = l.DateStart
                };
            })
            .Where(p => p.LapTimeSeconds > 0
                        || p.Sector1Seconds > 0
                        || p.Sector2Seconds > 0
                        || p.Sector3Seconds > 0
                        || p.TopSpeedKmh > 0
                        || p.Position is > 0)
            .OrderBy(p => p.DriverNumber)
            .ThenBy(p => p.LapNumber)
            .ToList();
    }
}
